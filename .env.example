SHOPIFY_STORE=xn68xb-0f.myshopify.com
SHOPIFY_CLIENT_ID=your-client-id
SHOPIFY_CLIENT_SECRET=shpss_your-client-secret

# WooCommerce REST API (geen officiële CLI — gebruik npm run wc:fetch-all)
WC_STORE_URL=https://www.bloemenvandegier.nl
WC_CONSUMER_KEY=ck_your_consumer_key
WC_CONSUMER_SECRET=cs_your_consumer_secret

# Pakketpartner (verzendlabels)
PAKKETPARTNER_API_KEY=ukey_your_api_key
# Optioneel – defaults staan al goed voor De Gier:
# PAKKETPARTNER_SENDER_HASH=s_PVBFAoct9QWX4qnB
# PAKKETPARTNER_CARRIER_AVOND=acsr_Lpz10eFIPukQuPEA
# PAKKETPARTNER_CARRIER_OVERDAG=acsr_jq9iO9bRPNQU4T7e

# Optioneel: handmatig access token (24u geldig bij client credentials)
# SHOPIFY_ADMIN_API_TOKEN=shpat_...
