/* Bloemen van De Gier - Shopify Theme
   Design tokens van origineel Next.js project
*/

:root {
  /* Primary greens - uit tailwind.config */
  --color-primary-50: #f0f5f2;
  --color-primary-100: #d9e6dd;
  --color-primary-200: #b3cdbb;
  --color-primary-300: #8db499;
  --color-primary-400: #669b77;
  --color-primary-500: #356443;
  --color-primary-600: #2a5036;
  --color-primary-700: #1f3c29;
  --color-primary-800: #15281c;
  --color-primary-900: #0a140f;
  --color-accent: #f59e0b;
  --color-accent-hover: #d97706;
  --font-sans: 'Inter', system-ui, sans-serif;
  --font-serif: 'Playfair Display', serif;
  --container-max: 1280px;
  --spacing: 1rem;
}

*,
*::before,
*::after {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: var(--font-sans);
  font-size: 16px;
  line-height: 1.5;
  color: #111827;
  background: #fff;
  -webkit-font-smoothing: antialiased;
}

a {
  color: inherit;
  text-decoration: none;
}

img {
  max-width: 100%;
  height: auto;
  display: block;
}

/* Container */
.container {
  width: 100%;
  max-width: var(--container-max);
  margin: 0 auto;
  padding-left: var(--spacing);
  padding-right: var(--spacing);
}

/* Utilities */
.visually-hidden {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  border: 0;
}

.rte {
  line-height: 1.7;
}
.rte p { margin: 0 0 1em; }
.rte ul, .rte ol { padding-left: 1.5em; }

/* Buttons */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0.75rem 1.5rem;
  font-family: var(--font-sans);
  font-size: 1rem;
  font-weight: 500;
  border-radius: 0.5rem;
  border: none;
  cursor: pointer;
  transition: background-color 0.2s, color 0.2s;
}
.btn--primary {
  background: var(--color-accent);
  color: #fff;
}
.btn--primary:hover {
  background: var(--color-accent-hover);
}
.btn--lg {
  padding: 1rem 2rem;
  font-size: 1.125rem;
}

/* ========== HEADER ========== */
.header {
  --primary: var(--color-primary-500);
  --primary-dark: var(--color-primary-600);
}

.bg-primary { background-color: var(--color-primary-500); }
.border-primary-dark { border-color: var(--color-primary-600); }

.header__inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 4rem;
  gap: 1.5rem;
}

.header__logo {
  flex-shrink: 0;
}
.header__logo-img {
  height: 2.5rem;
  width: auto;
}
.header__logo-text {
  font-family: var(--font-serif);
  font-weight: 700;
  font-size: 1.25rem;
  color: #fff;
}

.header__nav {
  display: none;
}
@media (min-width: 1024px) {
  .header__nav { display: block; }
}

.header__nav-list {
  display: flex;
  align-items: center;
  gap: 1.5rem;
  list-style: none;
  margin: 0;
  padding: 0;
}

.header__nav-list a {
  color: #fff;
  font-size: 0.9375rem;
  font-weight: 500;
}
.header__nav-list a:hover {
  color: var(--color-primary-100);
}

.header__actions {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.header__action {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0.5rem;
  color: #fff;
  transition: color 0.2s;
}
.header__action:hover {
  color: var(--color-primary-100);
}

.header__icon {
  width: 1.25rem;
  height: 1.25rem;
}

.header__cart {
  position: relative;
}

.header__cart-count {
  position: absolute;
  top: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 1.25rem;
  height: 1.25rem;
  padding: 0 0.25rem;
  font-size: 0.75rem;
  font-weight: 700;
  color: var(--color-primary-600);
  background: #fff;
  border-radius: 9999px;
}

.header__menu-btn {
  display: flex;
  padding: 0.5rem;
  color: #fff;
  background: none;
  border: none;
  cursor: pointer;
}
@media (min-width: 1024px) {
  .header__menu-btn { display: none; }
}

.header__mobile {
  display: none;
  padding: 1rem;
  background: var(--color-primary-600);
  border-top: 1px solid rgba(255,255,255,0.1);
}
.header__mobile[data-open="true"] {
  display: block;
}

.header__mobile-nav {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}
.header__mobile-nav a {
  color: #fff;
  padding: 0.5rem 0;
}
.header__mobile-nav a:hover {
  color: var(--color-primary-100);
}

/* ========== TRUST BAR ========== */
.trust-bar {
  background: var(--color-primary-50);
  border-bottom: 1px solid var(--color-primary-100);
}

.trust-bar__items {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 1.5rem;
  padding: 0.75rem 0;
  font-size: 0.875rem;
  color: #374151;
}

.trust-bar__item {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.trust-bar__icon {
  width: 1.25rem;
  height: 1.25rem;
  flex-shrink: 0;
  color: var(--color-primary-600);
}

.trust-bar__highlight {
  color: var(--color-primary-600);
  font-weight: 700;
}

@media (max-width: 767px) {
  .trust-bar__items {
    flex-direction: column;
    gap: 0.5rem;
  }
}

/* ========== FOOTER ========== */
.footer {
  background: var(--color-primary-500);
  color: #fff;
  padding: 3rem 0;
}

.footer__grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 2rem;
  margin-bottom: 2rem;
}
@media (min-width: 768px) {
  .footer__grid {
    grid-template-columns: repeat(2, 1fr);
  }
}
@media (min-width: 1024px) {
  .footer__grid {
    grid-template-columns: repeat(4, 1fr);
  }
}

.footer__logo-img {
  height: 2.5rem;
  width: auto;
  filter: brightness(0) invert(1);
}
.footer__logo-text {
  font-family: var(--font-serif);
  font-weight: 700;
  font-size: 1.25rem;
}

.footer__title {
  margin: 1rem 0 0.5rem;
  font-size: 1.125rem;
  font-weight: 700;
}

.footer__heading {
  margin: 0 0 1rem;
  font-size: 1rem;
  font-weight: 600;
}

.footer__text {
  margin: 0 0 0.5rem;
  font-size: 0.875rem;
}
.footer__text--muted {
  opacity: 0.9;
}

.footer__links {
  list-style: none;
  margin: 0;
  padding: 0;
}
.footer__links li {
  margin-bottom: 0.5rem;
}
.footer__links a {
  color: rgba(255,255,255,0.8);
  font-size: 0.875rem;
}
.footer__links a:hover {
  color: #fff;
}

.footer__bottom {
  padding-top: 2rem;
  border-top: 1px solid rgba(255,255,255,0.3);
  text-align: center;
  font-size: 0.875rem;
  opacity: 0.8;
}

/* ========== HERO ========== */
.hero {
  position: relative;
  min-height: var(--hero-height-mobile, 380px);
  display: flex;
  align-items: center;
  overflow: hidden;
}
@media (min-width: 1024px) {
  .hero {
    min-height: var(--hero-height-desktop, 480px);
  }
}

.hero__bg {
  position: absolute;
  inset: 0;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  background-color: var(--color-primary-500);
}

.hero__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to right, rgba(53, 100, 67, 0.85), rgba(53, 100, 67, 0.4));
}

.hero__content {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  width: 100%;
}

.hero__text {
  max-width: 36rem;
}

.hero__title {
  margin: 0 0 1rem;
  font-family: var(--font-serif);
  font-size: clamp(1.875rem, 4vw, 3.75rem);
  font-weight: 700;
  line-height: 1.2;
  color: #fff;
  text-shadow: 0 4px 6px rgba(0,0,0,0.2);
}

.hero__subtitle {
  margin: 0 0 1.5rem;
  font-size: clamp(1rem, 1.5vw, 1.25rem);
  color: #fff;
  line-height: 1.6;
  text-shadow: 0 2px 4px rgba(0,0,0,0.2);
}

.hero__btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 1rem 2rem;
  font-size: 1.125rem;
  font-weight: 500;
  color: #fff;
  background: var(--color-accent);
  border-radius: 0.5rem;
  transition: background 0.2s;
}
.hero__btn:hover {
  background: var(--color-accent-hover);
}

.hero__circle {
  display: none;
  position: absolute;
  right: 0;
  top: 50%;
  transform: translate(50%, -50%);
  width: min(85vw, 400px);
  height: min(85vw, 400px);
  border-radius: 50%;
  border: 6px solid;
  background-size: cover;
  background-position: center;
  box-shadow: 0 10px 25px rgba(0,0,0,0.2);
}
@media (min-width: 1024px) {
  .hero__circle {
    display: block;
    width: min(750px, 50vw);
    height: min(750px, 50vw);
  }
}

/* ========== USP ========== */
.usp {
  padding: 4rem 0;
  background: #fff;
}
@media (min-width: 768px) {
  .usp {
    padding: 6rem 0;
  }
}

.usp__header {
  text-align: center;
  margin-bottom: 3rem;
}

.usp__title {
  margin: 0 0 0.5rem;
  font-family: var(--font-serif);
  font-size: clamp(1.875rem, 3vw, 2.25rem);
  font-weight: 700;
  color: #111827;
}

.usp__subtitle {
  margin: 0;
  font-size: 1.125rem;
  color: #4b5563;
  max-width: 42rem;
  margin-left: auto;
  margin-right: auto;
}

.usp__grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 2rem;
}
@media (min-width: 768px) {
  .usp__grid {
    grid-template-columns: repeat(2, 1fr);
  }
}
@media (min-width: 1024px) {
  .usp__grid {
    grid-template-columns: repeat(4, 1fr);
  }
}

.usp__item {
  text-align: center;
}

.usp__icon-wrap {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 4rem;
  height: 4rem;
  margin: 0 auto 1rem;
  background: var(--color-primary-100);
  color: var(--color-primary-600);
  border-radius: 50%;
}

.usp__icon {
  width: 2rem;
  height: 2rem;
}

.usp__item-title {
  margin: 0 0 0.5rem;
  font-size: 1.25rem;
  font-weight: 700;
  color: #111827;
}

.usp__item-text {
  margin: 0;
  font-size: 0.9375rem;
  color: #4b5563;
  line-height: 1.6;
}

/* ========== PRODUCT PAGE ========== */
.product-page {
  padding: 3rem 0;
}

.product-page__grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 2rem;
}
@media (min-width: 768px) {
  .product-page__grid {
    grid-template-columns: 1fr 1fr;
    align-items: start;
  }
}

.product-page__gallery img {
  width: 100%;
  aspect-ratio: 1;
  object-fit: cover;
  border-radius: 0.5rem;
}

.product-page__placeholder {
  aspect-ratio: 1;
  background: var(--color-primary-100);
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 0.5rem;
  color: var(--color-primary-600);
}

.product-page__title {
  margin: 0 0 0.5rem;
  font-family: var(--font-serif);
  font-size: 2rem;
  font-weight: 700;
  color: #111827;
}

.product-page__price {
  display: block;
  margin-bottom: 1rem;
  font-size: 1.5rem;
  font-weight: 600;
  color: var(--color-primary-600);
}

.product-page__description {
  margin-bottom: 1.5rem;
  color: #4b5563;
}

/* ========== COLLECTION PAGE ========== */
.collection-page {
  padding: 3rem 0;
}

.collection-page__title {
  margin: 0 0 0.5rem;
  font-family: var(--font-serif);
  font-size: 2rem;
  font-weight: 700;
  color: #111827;
}

.collection-page__description {
  margin-bottom: 2rem;
  color: #4b5563;
}

.collection-page__grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1rem;
}
@media (min-width: 640px) {
  .collection-page__grid {
    grid-template-columns: repeat(3, 1fr);
  }
}
@media (min-width: 1024px) {
  .collection-page__grid {
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }
}

.product-card {
  display: block;
  transition: transform 0.2s;
}
.product-card:hover {
  transform: translateY(-2px);
}

.product-card__image {
  aspect-ratio: 1;
  overflow: hidden;
  border-radius: 0.5rem;
  background: var(--color-primary-50);
}
.product-card__image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.product-card__placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-primary-400);
  font-size: 0.875rem;
}

.product-card__title {
  margin: 0.5rem 0 0.25rem;
  font-size: 0.9375rem;
  font-weight: 600;
  color: #111827;
}

.product-card__price {
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--color-primary-600);
}

.collection-page__empty {
  grid-column: 1 / -1;
  text-align: center;
  color: #6b7280;
  padding: 2rem;
}

/* ========== CART PAGE ========== */
.cart-page {
  padding: 3rem 0;
}

.cart-page__title {
  margin: 0 0 2rem;
  font-family: var(--font-serif);
  font-size: 2rem;
  font-weight: 700;
  color: #111827;
}

.cart-item {
  display: flex;
  gap: 1rem;
  padding: 1rem 0;
  border-bottom: 1px solid #e5e7eb;
}

.cart-item__image {
  width: 80px;
  height: 80px;
  flex-shrink: 0;
  border-radius: 0.5rem;
  overflow: hidden;
}
.cart-item__image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.cart-item__title {
  font-weight: 600;
  color: #111827;
}
.cart-item__title:hover {
  color: var(--color-primary-600);
}

.cart-item__price {
  display: block;
  margin: 0.25rem 0;
  font-weight: 600;
  color: var(--color-primary-600);
}

.cart-page__footer {
  margin-top: 2rem;
  padding-top: 1.5rem;
  border-top: 1px solid #e5e7eb;
}

.cart-page__total {
  font-size: 1.25rem;
  font-weight: 700;
  margin-bottom: 1rem;
}

.cart-page__footer .btn {
  margin-right: 0.5rem;
  margin-bottom: 0.5rem;
}

.cart-page__empty {
  margin-bottom: 1rem;
  color: #6b7280;
}

/* ========== PAGINATION ========== */
.pagination {
  margin-top: 2rem;
}

.pagination__list {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  list-style: none;
  margin: 0;
  padding: 0;
}

.pagination__link,
.pagination__current {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 2.5rem;
  height: 2.5rem;
  padding: 0 0.5rem;
  font-size: 0.875rem;
  border-radius: 0.375rem;
  transition: background 0.2s, color 0.2s;
}

.pagination__link {
  color: var(--color-primary-600);
}
.pagination__link:hover {
  background: var(--color-primary-100);
  color: var(--color-primary-700);
}

.pagination__current {
  background: var(--color-primary-500);
  color: #fff;
}
