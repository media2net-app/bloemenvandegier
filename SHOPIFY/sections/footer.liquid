<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__col">
        <a href="{{ routes.root_url }}" class="footer__logo">
          {%- assign logo = section.settings.logo | default: settings.logo -%}
          {%- if logo != blank -%}
            <img src="{{ logo | image_url: width: 200 }}" alt="{{ shop.name }}" width="200" height="50" class="footer__logo-img">
          {%- else -%}
            <span class="footer__logo-text">{{ shop.name }}</span>
          {%- endif -%}
        </a>
        <h3 class="footer__title">{{ 'footer.company' | t }}</h3>
        <p class="footer__text">{{ 'footer.address' | t }}</p>
        <p class="footer__text footer__text--muted">{{ 'footer.description' | t }}</p>
      </div>
      <div class="footer__col">
        <h4 class="footer__heading">{{ 'footer.service' | t }}</h4>
        <ul class="footer__links">
          <li><a href="/pages/veelgestelde-vragen">{{ 'footer.faq' | t }}</a></li>
          <li><a href="/pages/zakelijk">{{ 'footer.business' | t }}</a></li>
          <li><a href="/pages/verzendkosten">{{ 'footer.shipping' | t }}</a></li>
          <li><a href="/pages/contact">{{ 'footer.contact' | t }}</a></li>
          <li><a href="/policies/privacy-policy">{{ 'footer.privacy' | t }}</a></li>
        </ul>
      </div>
      <div class="footer__col">
        <h4 class="footer__heading">{{ 'footer.categories' | t }}</h4>
        <ul class="footer__links">
          <li><a href="{{ routes.collections_url }}">{{ 'footer.roses' | t }}</a></li>
          <li><a href="{{ routes.collections_url }}">{{ 'footer.bouquets' | t }}</a></li>
          <li><a href="{{ routes.collections_url }}">{{ 'footer.subscriptions' | t }}</a></li>
        </ul>
      </div>
      <div class="footer__col">
        <h4 class="footer__heading">{{ 'footer.occasions' | t }}</h4>
        <ul class="footer__links">
          <li><a href="{{ routes.collections_url }}">{{ 'footer.mothers_day' | t }}</a></li>
          <li><a href="{{ routes.collections_url }}">{{ 'footer.valentines' | t }}</a></li>
          <li><a href="{{ routes.collections_url }}">{{ 'footer.christmas' | t }}</a></li>
        </ul>
      </div>
    </div>
    <div class="footer__bottom">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ 'footer.rights' | t }}</p>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    }
  ]
}
{% endschema %}
