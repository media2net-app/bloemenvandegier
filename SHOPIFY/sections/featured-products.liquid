<section class="featured-products">
  <div class="container">
    <div class="featured-products__header">
      <div>
        <h2 class="featured-products__title">{{ section.settings.title }}</h2>
        <p class="featured-products__subtitle">{{ section.settings.subtitle }}</p>
      </div>
      <a href="{{ section.settings.collection.url | default: routes.all_products_collection_url }}" class="featured-products__link">
        {{ section.settings.link_text }}
        <svg class="featured-products__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>

    <div class="featured-products__grid">
      {%- assign collection = section.settings.collection | default: collections.all -%}
      {%- assign count = 0 -%}
      {%- for product in collection.products -%}
        {%- if product.featured_image and count < section.settings.limit -%}
          {% render 'product-card', product: product, show_rating: section.settings.show_rating %}
          {%- assign count = count | plus: 1 -%}
        {%- endif -%}
        {%- if count >= section.settings.limit -%}{%- break -%}{%- endif -%}
      {%- endfor -%}
      {%- if count == 0 -%}
        {%- for i in (1..8) -%}
          <div class="product-card product-card--placeholder">
            <div class="product-card__image"><div class="product-card__placeholder">{{ 'product.no_image' | t }}</div></div>
            <div class="product-card__body">
              <h3 class="product-card__title">{{ 'product.placeholder_title' | t }}</h3>
              <div class="product-card__price">€ 0,00</div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Populaire producten",
  "class": "section-featured-products",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Titel",
      "default": "Populaire producten"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Ondertitel",
      "default": "Onze meest geliefde bloemen en boeketten"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collectie"
    },
    {
      "type": "range",
      "id": "limit",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8,
      "label": "Aantal producten"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link tekst",
      "default": "Bekijk alles"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Toon beoordelingen",
      "default": true
    }
  ]
}
{% endschema %}
